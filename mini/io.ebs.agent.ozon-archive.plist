<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pull the EEA archive forward, daily at 04:17.

  The EEA rewrites its E2a container roughly once per day (evidenced by the
  blob's Last-Modified). Fetching more often gains nothing; less often lets
  the long-term metrics go stale. --refresh is mandatory: without it the
  container stays in the cache and the series ends where it ended on the
  first run.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.ebs.agent.ozon-archive</string>
  <key>UserName</key>
  <string>agent</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/agent/git/ozon-vorarlberg/refresh_archive.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>17</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/agent/agents/logs/ozon/archive.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/agent/agents/logs/ozon/archive.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/agent</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/agent/git/ozon-vorarlberg</string>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
