<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ozone logger and deploy. Follows the agent-server conventions:

  * LaunchDaemon in /Library/LaunchDaemons with UserName=agent, not a
    LaunchAgent. Per-user agents only run while that user has an active
    session and would be dead after a reboot of the headless server.
  * StartCalendarInterval rather than StartInterval: if the machine was off at
    the scheduled time the run is skipped, not fired retroactively.
  * HOME, PATH and LANG have to be listed here. launchd does not set HOME and
    does not read .zshenv; without them git and gh fail.

  Three runs per hour, offset from :00. The source updates hourly and is
  deduplicated on its own timestamp, so two runs may be missed without
  leaving a gap.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.ebs.agent.ozon</string>
  <key>UserName</key>
  <string>agent</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/agent/git/ozon-vorarlberg/deploy.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>7</integer></dict>
    <dict><key>Minute</key><integer>27</integer></dict>
    <dict><key>Minute</key><integer>47</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/agent/agents/logs/ozon/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/agent/agents/logs/ozon/launchd.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/agent</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/agent/git/ozon-vorarlberg</string>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
