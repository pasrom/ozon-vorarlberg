<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ozon-Logger und Deploy, alle 20 Minuten.

  Warum 20 und nicht 60 Minuten: die Quelle aktualisiert stuendlich, und
  dedupliziert wird ueber deren Zeitstempel. Drei Laeufe pro Stunde kosten also
  nichts, aber zwei duerfen ausfallen, ohne dass eine Luecke entsteht.

  StartInterval statt StartCalendarInterval: nach einem Neustart oder Aufwachen
  laeuft der Job sofort wieder an, statt auf die naechste Kalenderminute zu
  warten.

  Installation und Entfernung: siehe setup_mini.sh
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.ebs.ozon-vorarlberg</string>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/deploy.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>1200</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO__/logs/deploy.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/deploy.err</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OZON_PYTHON</key>
        <string>__PYTHON__</string>
        <key>OZON_DEPLOY_KEY</key>
        <string>__KEY__</string>
    </dict>
</dict>
</plist>
