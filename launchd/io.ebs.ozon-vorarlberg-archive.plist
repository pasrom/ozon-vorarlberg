<?xml version="1.0" encoding="UTF-8"?>
<!--
  EEA-Archiv nachziehen, täglich um 04:17.

  --refresh ist zwingend: ohne ihn bleibt der Container airquality-p im Cache
  stehen und die Reihe endet dort, wo sie beim ersten Lauf endete.

  Der Lauf laedt rund 26 MB und braucht etwa 20 Sekunden. Er schreibt
  archive.json neu; der 20-Minuten-Job nimmt es beim naechsten Durchlauf mit.

  Taeglich, weil die EEA ihren E2a-Container etwa einmal pro Tag neu schreibt.
  Oefter abzurufen bringt nichts, seltener laesst die Langzeitkennzahlen
  veralten.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.ebs.ozon-vorarlberg-archive</string>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__REPO__/eea_archive.py</string>
        <string>--build</string>
        <string>--refresh</string>
        <string>--quiet</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>17</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__REPO__/logs/archive.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/archive.err</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
